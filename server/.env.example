# ===================================================
# Place Your Service — Backend API Environment Configuration Template
# Server runtime configuration for Render and local development
# IMPORTANT: Never commit actual secret keys or service-role keys!
# ===================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Allowed CORS Origin(s) - Comma-separated if multiple
CORS_ORIGIN=https://place-your-service.vercel.app,https://extreme-sales-services.vercel.app,http://localhost:5000,http://localhost:3000

# Supabase Server-Side Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Extreme Sales & Services (ESS) Integration Configuration
ESS_WEBHOOK_URL=https://extreme-sales-services-gh7s.onrender.com/api/webhooks/pys
ESS_WEBHOOK_SECRET=ess_pys_shared_secret_2026

# Machine-to-Machine (M2M) API Access Key for ESS Backend Service Calls
M2M_API_KEY=pys_m2m_ess_live_secret_key_2026
