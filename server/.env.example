# ===================================================
# Place Your Service — Backend API Environment Configuration Template
# Server runtime configuration for Render and local development
# IMPORTANT: Never commit actual secret keys or service-role keys!
# ===================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Allowed CORS Origin(s) - Comma-separated if multiple
# Local development default: http://localhost:5173
# Production default: Your Vercel domain (e.g., https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Supabase Server-Side Configuration
# IMPORTANT: The SUPABASE_SERVICE_ROLE_KEY belongs ONLY to the backend server.
# It must NEVER be exposed to Vite, the frontend, or Git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
