# ===================================================
# Place Your Service — Environment Configuration Template
# Copy this file to .env for local development.
# IMPORTANT: Never commit actual secret keys or service-role keys!
# ===================================================

# Application Identity
VITE_APP_NAME="Place Your Service"
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0

# Supabase Public API Configuration
# These are public/client-safe credentials only.
# Service-role keys must NEVER be exposed here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Backend API Configuration (Render Backend URL)
# In local development: http://localhost:5000/api/v1 (or http://localhost:5000)
# In production on Vercel: https://place-your-service-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

